@model FitnessRental.Web.Models.FitnessEquipmentViewModel

@{
    ViewData["Title"] = "Delete Fitness Equipment";
    var role = Context.Session.GetString("UserRole");
}

@if (role != "Admin")
{
    <div class="alert alert-danger">
        Only Admin can delete fitness equipment.
    </div>

    <a asp-action="Index" class="btn btn-secondary">Back</a>

    return;
}

<h2 class="text-danger">Delete Fitness Equipment</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this equipment?
</div>

<hr />

<dl class="row">

    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Brand</dt>
    <dd class="col-sm-9">@Model.Brand</dd>

    <dt class="col-sm-3">Type</dt>
    <dd class="col-sm-9">@Model.EquipmentType</dd>

    <dt class="col-sm-3">Functionality</dt>
    <dd class="col-sm-9">@Model.Functionality</dd>

    <dt class="col-sm-3">Weight</dt>
    <dd class="col-sm-9">@Model.Weight</dd>

    <dt class="col-sm-3">Price Per Day</dt>
    <dd class="col-sm-9">@Model.RentalPricePerDay</dd>

    <dt class="col-sm-3">Available</dt>
    <dd class="col-sm-9">
        @(Model.IsAvailable ? "Yes" : "No")
    </dd>

    <dt class="col-sm-3">Created At</dt>
    <dd class="col-sm-9">@Model.CreatedAt</dd>

</dl>

<form asp-action="DeleteConfirmed" method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>