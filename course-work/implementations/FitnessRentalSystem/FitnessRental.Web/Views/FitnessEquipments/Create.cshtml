@model FitnessRental.Web.Models.FitnessEquipmentViewModel

@{
    ViewData["Title"] = "Create Fitness Equipment";
    var role = Context.Session.GetString("UserRole");
}

@if (role != "Admin")
{
    <div class="alert alert-danger">
        Only Admin can create fitness equipment.
    </div>

    <a asp-action="Index" class="btn btn-secondary">Back</a>

    return;
}

<h2>Create Fitness Equipment</h2>

<hr />

<form asp-action="Create" method="post" enctype="multipart/form-data">

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Brand" class="form-label"></label>
        <input asp-for="Brand" class="form-control" />
        <span asp-validation-for="Brand" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EquipmentType" class="form-label">Equipment Type</label>
        <input asp-for="EquipmentType" class="form-control" />
        <span asp-validation-for="EquipmentType" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Functionality" class="form-label"></label>
        <textarea asp-for="Functionality" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Functionality" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Weight" class="form-label"></label>
        <input asp-for="Weight" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Weight" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="RentalPricePerDay" class="form-label">
            Rental Price Per Day
        </label>
        <input asp-for="RentalPricePerDay" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="RentalPricePerDay" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ImageFile" class="form-label">
            Equipment Image
        </label>
        <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
        <span asp-validation-for="ImageFile" class="text-danger"></span>
    </div>

    <input type="hidden" asp-for="ImageUrl" />

    <div class="form-check mb-3">
        <input asp-for="IsAvailable" class="form-check-input" />
        <label asp-for="IsAvailable" class="form-check-label">
            Available
        </label>
    </div>

    <button type="submit" class="btn btn-success">
        Create
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Back
    </a>

</form>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}