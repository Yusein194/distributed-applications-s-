@model FitnessRental.Web.Models.EquipmentRentalViewModel

@{
    ViewData["Title"] = "Delete Rental";
    var role = Context.Session.GetString("UserRole");
}

@if (role != "Admin")
{
    <div class="alert alert-danger">
        Only Admin can delete rentals.
    </div>

    <a asp-action="Index" class="btn btn-secondary">
        Back
    </a>

    return;
}

<h2 class="text-danger">Delete Rental</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this rental?
</div>

<hr />

<dl class="row">

    <dt class="col-sm-3">User Id</dt>
    <dd class="col-sm-9">@Model.UserId</dd>

    <dt class="col-sm-3">Equipment Id</dt>
    <dd class="col-sm-9">@Model.FitnessEquipmentId</dd>

    <dt class="col-sm-3">User Email</dt>
    <dd class="col-sm-9">@Model.UserEmail</dd>

    <dt class="col-sm-3">Equipment</dt>
    <dd class="col-sm-9">@Model.EquipmentName</dd>

    <dt class="col-sm-3">Rent Date</dt>
    <dd class="col-sm-9">@Model.RentDate</dd>

    <dt class="col-sm-3">Return Date</dt>
    <dd class="col-sm-9">@Model.ReturnDate</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Total Price</dt>
    <dd class="col-sm-9">@Model.TotalPrice</dd>

</dl>

<form asp-action="DeleteConfirmed" method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>